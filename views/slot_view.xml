<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_slot_list" model="ir.ui.view">
        <field name="name">clinic.slot.list</field>
        <field name="model">clinic.slot</field>
        <field name="arch" type="xml">
            <list string="Créneaux">
                <field name="start"/>
                <field name="stop"/>
                <field name="doctor_id"/>
                <field name="state" widget="badge"/>
                <field name="appointment_id"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_slot_form" model="ir.ui.view">
        <field name="name">clinic.slot.form</field>
        <field name="model">clinic.slot</field>
        <field name="arch" type="xml">
            <form string="Créneau">
                <header>
                    <button name="action_send" type="object" string="Envoyer au médecin"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirmer"
                            class="oe_highlight" invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <field name="doctor_id" readonly="state != 'draft' or appointment_id"/>
                        <field name="start" readonly="appointment_id"/>
                        <field name="stop" readonly="appointment_id"/>
                        <field name="appointment_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_clinic_slot" model="ir.actions.act_window">
        <field name="name">Créneaux</field>
        <field name="res_model">clinic.slot</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_clinic_slot_grid" model="ir.actions.act_url">
        <field name="name">Créneaux</field>
        <field name="url">/clinic/creneaux</field>
        <field name="target">self</field>
    </record>
</odoo>
