<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Liste (Tree) Patients -->
    <record id="view_clinic_patient_tree" model="ir.ui.view">
        <field name="name">clinic.patient.tree</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="code"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="dob"/>
                <field name="age"/>
                <field name="phone"/>
                <field name="blood_group"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire (Form) Patient -->
    <record id="view_clinic_patient_form" model="ir.ui.view">
        <field name="name">clinic.patient.form</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <form string="Fiche Patient">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom complet du patient..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Personnelles">
                            <field name="code"/>
                            <field name="gender"/>
                            <field name="dob"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                        </group>
                        <group string="Coordonnées">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Radios" name="radiology">
                            <field name="radiology_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="region"/>
                                    <field name="side"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Antécédents Médicaux" name="medical_history">
                            <field name="medical_history" placeholder="Saisir les antécédents, allergies, interventions passées..."/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Intégration du Chatter (Mail/Activity) -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action Fenêtre pour Patients -->
    <record id="action_clinic_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">clinic.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier patient !
            </p>
        </field>
    </record>

</odoo>