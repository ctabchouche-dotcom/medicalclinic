<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Liste Médecins -->
    <record id="view_clinic_doctor_tree" model="ir.ui.view">
        <field name="name">clinic.doctor.tree</field>
        <field name="model">clinic.doctor</field>
        <field name="arch" type="xml">
            <list string="Médecins">
                <field name="name"/>
                <field name="specialty"/>
                <field name="phone"/>
                <field name="consultation_fee"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire Médecin -->
    <record id="view_clinic_doctor_form" model="ir.ui.view">
        <field name="name">clinic.doctor.form</field>
        <field name="model">clinic.doctor</field>
        <field name="arch" type="xml">
            <form string="Fiche Médecin">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Dr. Nom Prénom..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Professionnelles">
                            <field name="specialty"/>
                            <field name="consultation_fee"/>
                            <field name="user_id" help="Compte du médecin qui se connecte à l'espace web /clinic. Le médecin principal et le manager restent dans Odoo et n'ont pas besoin de ce lien."/>
                        </group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action Fenêtre pour Médecins -->
    <record id="action_clinic_doctor" model="ir.actions.act_window">
        <field name="name">Médecins</field>
        <field name="res_model">clinic.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>