<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_prescription_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Ordonnance <span t-field="doc.name"/></h2>
                <div class="row mb-3">
                    <div class="col-7">
                        <p>
                            <strong>Patient :</strong> <span t-field="doc.patient_id.name"/><br/>
                            <strong>Âge :</strong> <span t-field="doc.patient_id.age"/> ans
                            — <strong>Sexe :</strong> <span t-field="doc.patient_id.gender"/><br/>
                            <strong>Date :</strong> <span t-field="doc.date"/>
                        </p>
                    </div>
                    <div class="col-5 text-end">
                        <p>
                            <strong>Dr.</strong> <span t-field="doc.doctor_id.name"/><br/>
                            <span t-field="doc.doctor_id.specialty"/>
                        </p>
                    </div>
                </div>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Médicament</th>
                            <th>Posologie</th>
                            <th>Durée</th>
                            <th>Quantité</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids" t-as="line">
                            <td>
                                <span t-out="line.medication_id.display_name"/>
                                <div t-if="line.instructions" style="font-size: 11px; color: #555;" t-out="line.instructions"/>
                            </td>
                            <td><span t-out="line.dosage"/></td>
                            <td><span t-out="line.duration"/></td>
                            <td><span t-out="line.quantity"/></td>
                        </tr>
                    </tbody>
                </table>
                <div t-if="doc.notes" class="mt-4">
                    <strong>Conseils :</strong>
                    <p t-field="doc.notes"/>
                </div>
                <p class="mt-5 text-end"><strong>Signature du médecin</strong></p>
            </div>
        </t>
    </template>

    <template id="report_prescription">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="medicalclinic.report_prescription_document"/>
            </t>
        </t>
    </template>
</odoo>
