<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_lab_voucher" model="report.paperformat">
        <field name="name">Bon de laboratoire</field>
        <field name="format">A5</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_clinic_lab_voucher" model="ir.actions.report">
        <field name="name">Bon de laboratoire</field>
        <field name="model">clinic.lab.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">medicalclinic.report_lab_voucher</field>
        <field name="report_file">medicalclinic.report_lab_voucher</field>
        <field name="print_report_name">'Bon_%s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_lab_voucher"/>
        <field name="binding_model_id" ref="model_clinic_lab_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Déclaration de l'action pour ajouter le bouton Imprimer -->
    <record id="action_report_clinic_lab_request" model="ir.actions.report">
        <field name="name">Bulletin d'Analyses Médicales</field>
        <field name="model">clinic.lab.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">medicalclinic.report_lab_request</field>
        <field name="report_file">medicalclinic.report_lab_request</field>
        <field name="print_report_name">'Analyse_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_clinic_lab_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Le modèle d'e-mail est en noupdate : on rattache le PDF à chaque mise à jour. -->
    <function model="clinic.lab.request" name="_configure_results_mail_template"/>

</odoo>