<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_lab_results" model="mail.template">
            <field name="name">Laboratoire : Résultats d'Analyses Disponibles</field>
            <field name="model_id" ref="medicalclinic.model_clinic_lab_request"/>
            <field name="subject">Vos résultats d'analyses médicales - {{ object.name }}</field>
            <field name="email_from">{{ object.env.company.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.patient_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p>Bonjour <strong t-out="object.patient_id.name or ''">Patient</strong>,</p>
                    <p>Vos résultats d'analyses médicales (Réf : <strong t-out="object.name or ''">LAB/001</strong>), prescrits par le <strong>Dr. <t t-out="object.doctor_id.name or ''">Médecin</t></strong>, sont disponibles.</p>
                    <p>Le bulletin PDF joint reprend chaque paramètre, son unité, les valeurs de référence et l'interprétation.</p>
                    <div style="margin: 25px 0; text-align: center;">
                        <a t-att-href="object.result_url or '#'" style="background-color: #00878a; color: #ffffff; padding: 12px 25px; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block;">
                            Consulter mes résultats en ligne
                        </a>
                    </div>
                    <p>Vous pouvez aussi scanner le QR code figurant sur le bulletin.</p>
                    <p>Cordialement,<br/><strong>Le service laboratoire</strong></p>
                </div>
            </field>
        </record>
    </data>
</odoo>