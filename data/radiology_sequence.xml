<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_clinic_patient" model="ir.sequence">
            <field name="name">Numéro patient</field>
            <field name="code">clinic.patient</field>
            <field name="prefix">PAT</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_clinic_radiology_request" model="ir.sequence">
            <field name="name">Demande de radiographie</field>
            <field name="code">clinic.radiology.request</field>
            <field name="prefix">RAD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
    <function model="clinic.patient" name="_assign_missing_codes"/>
</odoo>
