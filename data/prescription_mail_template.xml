<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_prescription" model="mail.template">
            <field name="name">Clinique : Ordonnance</field>
            <field name="model_id" ref="medicalclinic.model_clinic_prescription"/>
            <field name="subject">Votre ordonnance - {{ object.name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ object.patient_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p>Bonjour <strong t-out="object.patient_id.name or ''">Patient</strong>,</p>
                    <p>Veuillez trouver votre ordonnance en pièce jointe.</p>
                    <p>Cordialement,<br/><strong>La clinique</strong></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
